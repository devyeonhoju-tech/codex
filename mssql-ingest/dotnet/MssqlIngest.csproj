<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MssqlIngest</RootNamespace>
    <AssemblyName>mssql-ingest</AssemblyName>
    <!-- SqlClient refuses to open a connection when invariant globalization is on. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MssqlIngest.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient 7.1.1 pulls Pkcs 9.0.18 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.22" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\sql\001_database.sql">
      <LogicalName>schema.001_database.sql</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\sql\002_events.sql">
      <LogicalName>schema.002_events.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
